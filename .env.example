# ─────────────────────────────────────────────────────────────────────
#  Zovie chatbot (served by this Next.js app — no separate service)
# ─────────────────────────────────────────────────────────────────────
# The chatbot page lives in  public/zovie-chat.html  and is embedded by
# app/components/ChatbotWidget.tsx. Its backend is:
#   app/api/chat/route.ts      (free-text answers via OpenAI)
#   app/api/feedback/route.ts  (star ratings / support requests)
#
# Both work with NO configuration:
#   • /api/chat falls back to the built-in Zoiko knowledge base.
#   • /api/feedback is always written to the server logs.

# --- OpenAI (optional) ---
# When set, free-text questions are answered by the model using the
# Zoiko knowledge base as the system prompt. Without it the fallback
# knowledge base answers are used instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Feedback email (optional) ---
# Feedback is ALWAYS logged to the server console. Set these to also
# email each rating/support request through Resend (https://resend.com).
RESEND_API_KEY=
FEEDBACK_TO=help@zoikomobile.co.uk
FEEDBACK_FROM="Zovie Chatbot <onboarding@resend.dev>"
